@page
@{
    ViewData["Title"] = "Søg job";
}

<h2>Søg job</h2>

<div class="info-page">
    <p>
        Hos LeveringAPS søger vi engagerede medarbejdere, der har lyst til at være
        en del af en moderne dagligvarelevering.
    </p>

    <p>
        Som medarbejder kan du blandt andet hjælpe med ordrebehandling, pakning
        og levering af varer til kunder.
    </p>

    <p>
        Send en ansøgning til:
        <strong>job@leveringaps.dk</strong>
    </p>
</div>

<style>
    .info-page {
        max-width: 760px;
        background-color: white;
        padding: 24px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

        .info-page p {
            font-size: 16px;
            line-height: 1.6;
            color: #444;
        }
</style>
