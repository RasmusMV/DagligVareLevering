@page
@model DagligVareLevering.Pages.OrderFlow.OrderHistoryModel
@using DagligVareLevering.Models.Enums
@if (TempData["StatusMessage"] != null)
{
    <div class="alert alert-info">
        @TempData["StatusMessage"]
    </div>
}
@{

    @if(HttpContext.Session.GetString("UserRole") == "Customer" || HttpContext.Session.GetString("UserRole") == "Admin")
    {
        <h2 class="mb-4">Købshistorik</h2>
        <div class="row">
            @foreach (var order in Model.AllOrders)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                        
                            <h5 class="card-title">Ordre #@order.OrderId</h5>
                            <p><strong>Dato:</strong> @order.TimeOfOrder.ToString("dd-MM-yyyy HH:mm")</p>
                            <p><strong>Antal varer:</strong> @order.OrderLines.Sum(line => line.Quantity)</p>

                            <ul class="list-unstyled">
                                @foreach (var line in order.OrderLines)
                                {
                                    <li>
                                        <strong>@line.Product.Name</strong><br />
                                        Antal: @line.Quantity <br />
                                        pris: @line.GetLineTotal() kr.
                                    </li>
                                    <hr />
                                }
                            </ul>

                            <div class="mt-3">
                                <strong>Status:</strong> <br />
                                @order.Status <br />

                                <div class="d-flex gap-2 mt-2 mb-2">
                                    <form method="get" asp-page="/OrderFlow/TrackOrder">
                                        <input type="hidden" name="id" value="@order.OrderId" />
                                        <button type="submit" class="deliver-btn">Følg ordre</button>
                                    </form>

                                   @if (HttpContext.Session.GetString("UserRole") == "Customer"
                                   && order.Status != OrderStatus.Delivered
                                   && order.Status != OrderStatus.Cancelled
                                   && order.Status != OrderStatus.OutForDelivery)
                                   {
                                     <form method="post" asp-page-handler="CancelOrder"
                                              onsubmit="return confirm('Er du sikker på, at du vil annullere denne ordre?');">
                                             <input type="hidden" name="orderId" value="@order.OrderId" />
                                          <button type="submit" class="btn btn-danger">
                                            Annuller ordre
                                         </button>
                                    </form>
                                    }
                       


                                </div>
                               
                                <strong>Pris for denne ordre:</strong><br />
                                @order.GetTotalPrice() kr.
                            </div>
                            @if (HttpContext.Session.GetString("UserRole") == "Admin")
                            {
                                <form method="post" asp-page-handler="DeleteOrder"
                                      onsubmit="return confirm('Er du sikker på, at du vil slette denne ordre helt?');">
                                    <input type="hidden" name="orderId" value="@order.OrderId" />
                                    <button type="submit" class="btn btn-danger w-100 mt-2">
                                        Slet ordre
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
        
    {
        var role = HttpContext.Session.GetString("UserRole");
        if(role == "Customer")
        {
            <div class="mt-4">
                <h4>Samlet total for alle ordrer: @Model.GrandTotal kr.</h4>
                <p><strong>Samlet antal købte varer:</strong> @Model.TotalItems</p>
            </div>
        }
    }

    @if (HttpContext.Session.GetString("UserRole") == "Worker")
    {
        <h2 class="mb-4">Ledige ordrer</h2>
        <div class="row">
            @foreach (var order in Model.AllOrders)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">Ordre #@order.OrderId</h5>
                            <p><strong>Kunde:</strong> @order.User.Name</p>
                            <p><strong>Leveringsadresse:</strong> @order.Adress</p>
                            <p><strong>Antal varer:</strong> @order.OrderLines.Sum(l => l.Quantity)</p>
                            <ul class="list-unstyled">
                                @foreach (var line in order.OrderLines)
                                {
                                    <li>
                                        <strong>@line.Product.Name</strong><br />
                                        Antal: @line.Quantity
                                    </li>
                                    
                                }
                            </ul>
                           
                            <p><strong>Total:</strong> @order.GetTotalPrice() kr.</p>

                            <form method="post">
                                <input type="hidden" name="orderId" value="@order.OrderId" />
                                <button type="submit" asp-page-handler="TakeOrder"
                                        class="btn btn-primary w-100">
                                    Tag denne ordre
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

}