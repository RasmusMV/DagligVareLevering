@page
@{
    ViewData["Title"] = "Om os";
}

<h2>Om os</h2>

<div class="info-page">
    <p>
        LeveringAPS er en dagligvareleveringstjeneste, der gør det nemt for kunder
        at bestille varer online og få dem leveret direkte til døren.
    </p>

    <p>
        Vores mål er at gøre hverdagen lettere ved at samle indkøb, leveringstid
        og ordreoverblik ét sted.
    </p>
</div>

<style>
    .info-page {
        max-width: 760px;
        background-color: white;
        padding: 24px;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    }

        .info-page p {
            font-size: 16px;
            line-height: 1.6;
            color: #444;
        }
</style>
