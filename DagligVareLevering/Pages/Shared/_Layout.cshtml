<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DagligVareLevering</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DagligVareLevering.styles.css" asp-append-version="true" />
</head>
<body>
    @{
        var role = Context.Session.GetString("UserRole");
        var userId = Context.Session.GetInt32("UserId");
        var username = Context.Session.GetString("UserName");
    }
    <header>
        <nav class="custom-navbar">
            <div class="nav-left">
                <div class="dropdown">
                    <button class="menu-btn dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        Menu
                    </button>

                    <ul class="dropdown-menu">
                        <li>
                            <a class="dropdown-item" asp-page="/Index">Forside</a>
                        </li>

                        <li>
                            <a class="dropdown-item" asp-page="/Product/GetAllProducts">Køb ind</a>
                        </li>

                        <li>
                            <a class="dropdown-item" asp-page="/OrderFlow/OrderHistory">Ordrehistorik</a>
                        </li>
                    
                        

                        @if (userId != null)
                        {
                            <li><hr class="dropdown-divider" /></li>

                            <li>
                                <a class="dropdown-item" asp-page="/UserRelated/Account">Min bruger</a>
                            </li>

                            <li>
                                <a class="dropdown-item" asp-page="/UserRelated/Notifications">
                                    Notifikationer
                                </a>
                            </li>

                            @if (role == "Admin")
                            {
                                <li>
                                    <a class="dropdown-item" asp-page="/AdminChanges">Administrer brugere</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-page="/Statistics/Statistics">Statistik</a>
                                </li>
                            }

                            @if (role == "Worker")
                            {
                                <li>
                                    <a class="dropdown-item" asp-page="/OrderFlow/Worker">Worker dashboard</a>
                                </li>
                            }

                            <li>
                                <a class="dropdown-item" asp-page="/UserRelated/Logout">Log ud</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>

            <div class="nav-center">
                <a asp-page="/Index" class="brand-link">LeveringAPS</a>
            </div>

            <div class="nav-right">
                @if (userId == null)
                {
                    <a asp-page="/UserRelated/Login" class="nav-action">Log ind</a>
                    <a asp-page="/UserRelated/Register" class="nav-action">Opret</a>
                }
                else
                {
                    <span class="user-name">Hej @username</span>
                }

                <a asp-page="/OrderFlow/Cart" class="cart-link">Kurv</a>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="site-footer">
        <div class="footer-content">
            <p>&copy; 2026 - LeveringAPS</p>

            <div class="footer-links">
                <a asp-page="/Info/Privacy">Privatlivspolitik</a>
                <a asp-page="/Info/AboutUs">Om os</a>
                <a asp-page="/Info/Jobs">Søg job</a>
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
