@page
@model DagligVareLevering.Pages.Product.CreateProductModel
@{
}
<h1>Create Product</h1>

<form method="post">
	<div class="form-group">
		<label asp-for="ProductDto.Name" class="control-label"></label>
		<input asp-for="ProductDto.Name" class="form-control" />
		<span asp-validation-for="ProductDto.Name" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="ProductDto.Price" class="control-label"></label>
		<input asp-for="ProductDto.Price" class="form-control" />
		<span asp-validation-for="ProductDto.Price" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="ProductDto.Information" class="control-label"></label>
		<input asp-for="ProductDto.Information" class="form-control" />
		<span asp-validation-for="ProductDto.Information" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="ProductDto.StoreId" class="control-label">Store</label>
		<select asp-for="ProductDto.StoreId" class="form-control">
			<option value="">-- Vælg en store --</option>
			@foreach(var store in Model.StoreList)
					{
						<option value="@store.StoreId">@store.Name</option>
					}
		</select>
		<span asp-validation-for="ProductDto.StoreId" class="text-danger"></span>
	</div>
	<div class="form-group">
		<input type="submit" value="create" class="btn btn-primary" />
	</div>
</form>