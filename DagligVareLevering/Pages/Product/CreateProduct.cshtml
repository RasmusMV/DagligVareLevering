@page
@model DagligVareLevering.Pages.Product.CreateProductModel
@{
}
<h1>Create Product</h1>

<form method="post">
	<div class="form-group">
		<label asp-for="Product.Name" class="control-lable"></label>
		<input asp-for="Product.Name" class="form-control" />
		<span asp-validation-for="Product.Name" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="Product.Price" class="control-lable"></label>
		<input asp-for="Product.Price" class="form-control" />
		<span asp-validation-for="Product.Price" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label asp-for="Product.Information" class="control-lable"></label>
		<input asp-for="Product.Information" class="form-control" />
		<span asp-validation-for="Product.Information" class="text-danger"></span>
	</div>
	<div class="form-group">
		<label class="control-lable">Store</label>
		<input list="store-list" name="StoreName" class="form-control" placeholder="Søg efter en store" />
		<datalist id="store-list">
			@foreach(var store in Model.StoreList)
			{
				<option value="@store.Name"></option>
			}
		</datalist>
		<span asp-validation-for="StoreName" class="text-danger"></span>
	</div>
	<div class="form-group">
		<input type="submit" value="create" class="btn btn-primary" />
	</div>
</form>