@page
@model DagligVareLevering.Pages.Product.GroceriesModel
@{
}
<!-- Søgefeltet sender søgeteksten som en GET-request, så resultatet kan vises på samme side -->
<form method="get" class="search-form">
    <input asp-for="SearchText" class="search-input" placeholder="Søg efter mælk, rugbrød, frugt..." />
    <button type="submit" class="search-btn">Søg</button>
</form>

<!--Filtrerer produkter efter pris eller butik-->
<form method="get">
    <label>Max Pris:</label>
    <input type="number" name="maxPrice" value="@Request.Query["maxPrice"]" /> <!-- request query sørger for at input bliver bevaret -->

    <select name="storeId">
        <option value="">Alle Butikker</option>
        @foreach (var store in Model.Stores)
        {
            <option value="@store.StoreId"
                    selected="@(Request.Query["storeId"] == store.StoreId.ToString())">
                @store.Name
            </option>
        }
    </select>
    <button type="submit">Filtrer</button>  

</form>

<!-- cards som indeholder produkter med samme navn-->
<div class="container">
    <div class="product-grid">
            @foreach (var item in Model.Products)
            {
                <div class="card">
                    <h3>@item.Name</h3> <!-- Produkt navn -->
                    <p>@item.Information <br />
                       @Model.Stores.FirstOrDefault(x => x.StoreId == item.StoreId)?.Name <br />
                       @item.Price kr</p>

                       <!-- se produkt vidrerfører dig til en "side"" med produktinformation" -->
                    <a asp-page="/Product/ProductDetails" asp-route-id="@item.ProductId">
                        Se produkt
                    </a>
                    <!--tilføjer produkt til cart-->
                    <form method="post" asp-page-handler="AddToCart">
                        <input type="hidden" name="productId" value="@item.ProductId" />
                        <p>@item.Information <br />
                           @Model.Stores.FirstOrDefault(x => x.StoreId == item.StoreId)?.Name <br />
                           @item.Price kr</p>
                           </form>
                           <!-- se produkt vidrerfører dig til en "side"" med produktinformation" -->
                        <a asp-page="/Product/ProductDetails" asp-route-id="@item.ProductId">
                            Se produkt
                        </a>
                        <!--tilføjer produkt til cart-->
                        <form method="post" asp-page-handler="AddToCart">
                            <input type="hidden" name="productId" value="@item.ProductId" />
                            <button type="submit" class="btn-small">Tilføj Produkt</button>
                        </form>
                        @{
                            var role = HttpContext.Session.GetString("UserRole");
                            if(role == "Admin")
                            {
                                <a asp-page="/Product/EditProduct" asp-route-id="@item.ProductId">Opdater</a>
                                <form method="post" asp-page-handler="Delete" asp-route-id="@item.ProductId"
                                      onsubmit="return confirm('Are you sure you want to delete this product?');"
                                      class="d-inline m-0">
                                    <button type="submit" class="btn btn-primary btn-sm">Delete</button>
                                </form>
                            }
                        }
                        
                    </div>
                }
            </div>
        
    </div>
</div>

 
<style>
    .card {
        /* Add shadows to create the "card" effect */
        box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
        transition: 0.3s;
    }

        /* On mouse-over, add a deeper shadow */
        .card:hover {
            box-shadow: 0 8px 16px 0 rgba(0,0,0,0.2);
        }

    /* Add some padding inside the card container, and proper placement */
    .container {
        padding: 2px 16px;
        display: grid;
        justify-content: space-evenly;
    }

    .column {
        float: left;
        width: 33%;
    }

    /* Clear floats after the columns */
    .row:after {
        content: "";
        display: table;
        clear: both;
    }

    .product-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr); /* 3 columns */
        gap: 20px;
    }


</style>